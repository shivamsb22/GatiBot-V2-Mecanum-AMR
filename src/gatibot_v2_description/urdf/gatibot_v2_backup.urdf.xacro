<?xml version="1.0"?>
<robot name="gatibot_v2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Initial chassis dimensions in metres -->
  <xacro:property name="plate_length" value="0.17"/>
  <xacro:property name="plate_width" value="0.17"/>
  <xacro:property name="bottom_thickness" value="0.003"/>
  <xacro:property name="plate_thickness" value="0.002"/>
  <xacro:property name="wheel_radius" value="0.03"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_x" value="0.065"/>
  <xacro:property name="wheel_y" value="0.09"/>

  <!-- Main chassis frame -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${bottom_thickness}"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.25 0.27 0.29 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.09"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${bottom_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.09"/>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Four chassis levels -->
  <xacro:macro name="chassis_plate" params="name z">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
        </geometry>
        <material name="plate_black">
          <color rgba="0.12 0.13 0.15 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 0 ${z - 0.09}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:chassis_plate name="middle_plate_1" z="0.13"/>
  <xacro:chassis_plate name="middle_plate_2" z="0.17"/>
  <xacro:chassis_plate name="top_plate" z="0.21"/>

  <!-- Four vertical spacers -->
  <xacro:macro name="spacer" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="0.003" length="0.04"/>
        </geometry>
        <material name="spacer_grey">
          <color rgba="0.45 0.47 0.49 1"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.11"/>
    </joint>
  </xacro:macro>

  <xacro:spacer name="spacer_fl" x="0.07" y="0.07"/>
  <xacro:spacer name="spacer_fr" x="0.07" y="-0.07"/>
  <xacro:spacer name="spacer_rl" x="-0.07" y="0.07"/>
  <xacro:spacer name="spacer_rr" x="-0.07" y="-0.07"/>

  <!-- Four mecanum wheels -->
  <xacro:macro name="mecanum_wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_blue">
          <color rgba="0.05 0.25 0.65 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel name="front_left_wheel"
                       x="${wheel_x}" y="${wheel_y}"/>
  <xacro:mecanum_wheel name="front_right_wheel"
                       x="${wheel_x}" y="${-wheel_y}"/>
  <xacro:mecanum_wheel name="rear_left_wheel"
                       x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:mecanum_wheel name="rear_right_wheel"
                       x="${-wheel_x}" y="${-wheel_y}"/>

  <!-- RPLIDAR A1 placeholder -->
  <link name="rplidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
  </link>

  <joint name="rplidar_joint" type="fixed">
    <parent link="top_plate"/>
    <child link="rplidar_link"/>
    <origin xyz="0 0 0.04"/>
  </joint>

</robot>
